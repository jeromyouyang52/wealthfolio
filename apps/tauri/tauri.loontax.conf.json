{
  "productName": "LoonTax",
  "mainBinaryName": "LoonTax",
  "identifier": "ca.loontax.desktop",
  "bundle": {
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/jeromyouyang52/wealthfolio/releases/latest/download/latest.json"
      ]
    }
